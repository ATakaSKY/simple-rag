GEMINI_API_KEY=

# Change these if your local Postgres setup differs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rag

# Free-tier friendly defaults (override if needed).
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match VECTOR(n) in schema.sql (768 recommended for this project).
GEMINI_EMBEDDING_DIMENSIONS=768
